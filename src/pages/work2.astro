---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import DownloadCard from '../components/DownloadCard.astro';

// TOUTE LA LOGIQUE ICI (Entre les barres de séparation)
const docs = [
  { 
    title: "Cahiers des charges", 
    desc: "Cahiers des charges stadium compagny.", 
    url: "/Cahier.pdf", 
    tag: "DOC" 
  }
  { 
    title: "Shéma de l'infrastructure réseaux", 
    desc: "Shéma de l'infrastructure réseaux de l'infrastructure disponible pour l'E6.", 
    url: "/Shéma.docx", 
    tag: "DOC" 
  }
];
---

<BaseLayout title="E6" description="Mes ressources concernant l'examen pratique">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero title="Ma Veille" tagline="Voici ma veille" align="start" />

			<Grid variant="offset">
				{docs.map((doc) => (
					<li>
						<DownloadCard
							title={doc.title}
							description={doc.desc}
							url={doc.url}
							tag={doc.tag}
						/>
					</li>
				))}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
	</div>
</BaseLayout>
