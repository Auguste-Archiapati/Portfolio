---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="A propos de moi" description="Information sur le BTS SIO SISR">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="A propos"
				tagline="Merci d'avoir lu jusqu'ici , voila quelque détails sur le BTS et moi"
			>
				
			</Hero>
             <section>
				<h2 class="section-title">Veille Technologique</h2>
				<div class="content">
					<p>
					   Sécurité des objects connéctées
					</p>  
					<p>  
                       Evolution des solutions cloud
					</p> 
					<p>   
					   Facteur d'authentification
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">BTS SIO SISR</h2>
				<div class="content">
					<p>
						Le BTS SIO SISR (Solutions d’Infrastructure, Systèmes et Réseaux) est une formation de deux ans,
						accessible après un bac (souvent technologique ou général),
						qui prépare aux métiers liés à l’administration des systèmes et des réseaux informatiques.
					</p>
					<p>
					    Objectif de la formation :

                        Installer, configurer et maintenir des équipements informatiques (serveurs, postes, routeurs…)

                        Gérer des réseaux locaux ou étendus

                        Assurer la sécurité des systèmes et des données

                        Apporter un support technique aux utilisateurs
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Sur Moi</h2>
				<div class="content">
					<p>J'ai 18 ans.Je suis passioné de sport automobile, aviation, BD, Jeux Vidéos</p>
				</div>
			</section>
		    
			
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
