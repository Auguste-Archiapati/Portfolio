---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import DownloadCard from '../components/DownloadCard.astro';

export const prerender = true;

// Tes documents classés par catégorie
const entrepriseDocs = [
	{ title: "Gestion du Parc", desc: "Inventaire et maintenance via GLPI.", url: "/Gestion du Parc.docx", tag: "DOCX" },
	{ title: "Masterisation PC", desc: "Configuration et mise à disposition d'ordinateurs.", url: "/Masterisation (1).docx", tag: "DOCX" },
	{ title: "Réparation Poste", desc: "Rapport d'intervention et modification matérielle.", url: "/Réparation.docx", tag: "DOCX" },
	{ title: "Réseau Wifi Radius", desc: "Mise en place d'une authentification RADIUS.", url: "/Mise en place d’une authentification RADIUS-2024.pdf", tag: "PDF" },
	{ title: "Procédure Tablette", desc: "Configuration et mise à disposition de tablettes.", url: "public/Procédure Tablette.docx", tag: "DOCX" }
];

const ecoleDocs = [
	{ title: "Tableau de Synthèse", desc: "Récapitulatif des compétences du BTS.", url: "/Tableau Compétences Auguste Archiapati.xlsx", tag: "XLSX" },
	{ title: "OCS Inventory", desc: "Mise en place de l'inventaire automatique.", url: "/ocs.docx", tag: "DOCX" },
	{ title: "Active Directory", desc: "Gestion des utilisateurs et des groupes.", url: "/ad.docx", tag: "DOCX" },
	{ title: "GLPI Scolaire", desc: "Gestion de parc et helpdesk.", url: "/glpi.docx", tag: "DOCX" },
	{ title: "Pfsense", desc: "Configuration du pare-feu et routage.", url: "/pf.docx", tag: "DOCX" }
];
---

<BaseLayout
	title="E5 | Auguste Archiapati"
	description="Mes projets scolaires et professionnels"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="E5"
				tagline="Voici tous mes projets réalisés durant mes années de BTS"
				align="start"
			/>

			<section class="stack gap-4">
				<h2 class="section-title">Réalisation en entreprise</h2>
				<Grid variant="offset">
					{entrepriseDocs.map((doc) => (
						<li>
							<DownloadCard 
								title={doc.title} 
								description={doc.desc} 
								url={doc.url} 
								tag={doc.tag} 
							/>
						</li>
					))}
				</Grid>
			</section>

			<section class="stack gap-4">
				<h2 class="section-title">Réalisation à l'école</h2>
				<Grid variant="offset">
					{ecoleDocs.map((doc) => (
						<li>
							<DownloadCard 
								title={doc.title} 
								description={doc.desc} 
								url={doc.url} 
								tag={doc.tag} 
							/>
						</li>
					))}
				</Grid>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.section-title {
		font-size: var(--text-2xl);
		color: var(--gray-0);
		border-bottom: 1px solid var(--gray-800);
		padding-bottom: 0.5rem;
		margin-top: 2rem;
	}
</style>
