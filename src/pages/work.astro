---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
export const prerender = true;

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="Mes Travaux | Auguste Archiapati"
	description="Mes projets scolaires"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Mes Travaux"
				tagline="Voici touts mes projets réalisée durant mes années de BTS "
				align="start"
			/>
			<table align="center">
  <tr>
    <td bgcolor="#f6f8fa" style="border-radius: 20px; padding: 20px;" width="320" valign="top">
      <div align="center">
        <br><br>
        <h3 align="center">Tableau de Synthése</h3>
        <p align="center">Récapitulatif des compétences.</p>
        <a href="public/assets/ad.docx" download>
          <alt="Download">
        </a>
        <br>
      </div>
    </td>
  </tr>
</table>
</table>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
