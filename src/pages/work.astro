---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import DownloadCard from '../components/DownloadCard.astro';

const base = import.meta.env.BASE_URL; // Récupère '/Portfolio/'

const entrepriseDocs = [
    { title: "Masterisation PC", desc: "Configuration et mise à disposition d'ordinateurs.", url: `${base}masterisationsoco.pdf`, tag: "PDF" },
    { title: "Réparation Poste", desc: "Réparation de poste en vue de réutilisation.", url: `${base}repasoco.pdf`, tag: "PDF" },
    { title: "Procédure Tablette", desc: "Configuration et mise à disposition de tablettes.", url: `${base}tabelttesoco.pdf`, tag: "PDF" },
    { title: "Retour Matériel", desc: "Retour de poste en fin de vie ou pour réparation.", url: `${base}retoursoco.pdf`, tag: "PDF" },
    { title: "WelcomeDay", desc: "Présentation pour les nouveaux arrivants.", url: `${base}wdsoco.pdf`, tag: "PDF" }
];

const ecoleDocs = [
    { title: "Tableau de Synthèse", desc: "Récapitulatif des compétences du BTS.", url: `${base}tableaucompetence.xlsx`, tag: "XLSX" },
    { title: "OCS Inventory", desc: "Mise en place de l'inventaire automatique.", url: `${base}ocs.pdf`, tag: "PDF" },
    { title: "Active Directory", desc: "Gestion des utilisateurs et des groupes.", url: `${base}ad.docx`, tag: "DOCX" },
    { title: "GLPI Scolaire", desc: "Gestion de parc et helpdesk.", url: `${base}glpi.pdf`, tag: "PDF" },
    { title: "Pfsense", desc: "Configuration du pare-feu et routage.", url: `${base}pf.pdf`, tag: "PDF" },
    { title: "Réseau Wifi Radius", desc: "Mise en place authentification RADIUS.", url: `${base}radius.pdf`, tag: "PDF" }
];
---

<BaseLayout title="Mes Documents" description="Documents professionnels et scolaires">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero title="Mes Documents" tagline="Travaux réalisés en entreprise et à l'école." align="start" />

			<h2 class="section-title">Mes réalisations en entreprise durant mes stages</h2>
			<Grid variant="offset">
				{entrepriseDocs.map((doc) => (
					<li>
						<DownloadCard 
							title={doc.title}
							description={doc.desc} 
							url={doc.url}
							tag={doc.tag}
						/>
					</li>
				))}
			</Grid>

			<h2 class="section-title">Projets Scolaires</h2>
			<Grid variant="offset">
				{ecoleDocs.map((doc) => (
					<li>
						<DownloadCard 
							title={doc.title}
							description={doc.desc}
							url={doc.url}
							tag={doc.tag}
						/>
					</li>
				))}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
