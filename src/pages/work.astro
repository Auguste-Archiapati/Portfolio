---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
export const prerender = true;

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="Mes Travaux | Auguste Archiapati"
	description="Mes projets scolaires"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Mes Travaux"
				tagline="Voici touts mes projets réalisée durant mes années de BTS "
				align="start"
			/>
			<table align="center" border="0" cellpadding="0" cellspacing="10">
  <tr>
    <td bgcolor="#f6f8fa" style="border-radius: 20px; padding: 20px;" width="300" valign="top">
      <div align="center">
        <img src="./public/assets/stock-2.jpg" style="border-radius: 15px;" width="260">
        <br><br>
        <h3>AD</h3>
        <p>Une description courte qui tient dans la bulle pour expliquer le contenu du PDF.</p>
        <a href="./votre-fichier.pdf">
           <img src="https://img.shields.io/badge/VOIR_LE_PDF-blue?style=for-the-badge&logo=read-the-docs&logoColor=white" />
        </a>
      </div>
    </td>
    
    <td bgcolor="#f6f8fa" style="border-radius: 20px; padding: 20px;" width="300" valign="top">
      <div align="center">
        <img src="https://via.placeholder.com/260x140" style="border-radius: 15px;" width="260">
        <br><br>
        <h3>Guide Pratique</h3>
        <p>Ce guide contient toutes les instructions nécessaires pour l'installation.</p>
        <a href="./guide.pdf">
           <img src="https://img.shields.io/badge/VOIR_LE_PDF-blue?style=for-the-badge&logo=read-the-docs&logoColor=white" />
        </a>
      </div>
    </td>
  </tr>
</table>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
