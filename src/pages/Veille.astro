---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import DownloadCard from '../components/DownloadCard.astro';

// 1. TOUT LE CODE LOGIQUE DOIT ÊTRE ICI
const docs = [
  { 
    title: "Mise en place authentification RADIUS", 
    desc: "Documentation technique sur RADIUS 2024.", 
    url: "/Mise en place d’une authentification RADIUS-2024.pdf", 
    format: "PDF" 
  },
  { 
    title: "Procédure Tablette", 
    desc: "Guide de configuration des tablettes.", 
    url: "/Procédure Tablette.docx", 
    format: "DOCX" 
  },
  { 
    title: "Réparation", 
    desc: "Compte rendu de réparation matérielle.", 
    url: "/Réparation.docx", 
    format: "DOCX" 
  }
];
---

<BaseLayout
	title="Ma Veille | Auguste Archiapati"
	description="Mes sujets de veille technologiques"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Ma Veille"
				tagline="Voici les différentes veilles réalisées"
				align="start"
			/>

			<Grid variant="offset">
				{
					docs.map((doc) => (
						<li>
							<DownloadCard
								title={doc.title}
								description={doc.desc}
								url={doc.url}
								tag={doc.format}
							/>
						</li>
					))
				}
			</Grid>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>
