---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import DownloadCard from '../components/DownloadCard.astro';

// TOUTE LA LOGIQUE ICI (Entre les barres de séparation)
const docs = [
  { 
    title: "Veille", 
    desc: "Compte rendu de ma veille sur .", 
    url: "/Veille.docx", 
    tag: "DOC" 
  }
];
---

<BaseLayout title="Ma Veille" description="Mes sujets de veille">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero title="Ma Veille" tagline="Voici mes veilles" align="start" />

			<Grid variant="offset">
				{docs.map((doc) => (
					<li>
						<DownloadCard
							title={doc.title}
							description={doc.desc}
							url={doc.url}
							tag={doc.tag}
						/>
					</li>
				))}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
	</div>
</BaseLayout>
