Extrait de code
---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import DownloadCard from '../components/DownloadCard.astro';

// 1. TOUTE LA LOGIQUE DOIT ÊTRE ICI (Frontmatter)
const docs = [
  { 
    title: "Mise en place RADIUS", 
    desc: "Documentation technique sur l'authentification RADIUS.", 
    url: "/Mise en place d’une authentification RADIUS-2024.pdf", 
    format: "PDF" 
  },
  { 
    title: "Réparation", 
    desc: "Compte rendu de réparation matérielle.", 
    url: "/Réparation.docx", 
    format: "DOC" 
  },
  { 
    title: "Gestion du Parc", 
    desc: "Inventaire et gestion du parc informatique.", 
    url: "/Gestion du Parc.docx", 
    format: "DOC" 
  }
];
---

<BaseLayout
	title="Ma Veille | Auguste Archiapati"
	description="Mes sujets de veille technologiques"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Ma Veille"
				tagline="Voici les différentes veilles réalisées"
				align="start"
			/>

			<Grid variant="offset">
				{
					docs.map((doc) => (
						<li>
							<DownloadCard
								title={doc.title}
								description={doc.desc}
								url={doc.url}
								tag={doc.format}
							/>
						</li>
					))
				}
			</Grid>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>
