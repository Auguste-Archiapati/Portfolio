---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import DownloadCard from '../components/DownloadCard.astro';

// Tes données de téléchargement
const docs = [
  { title: "Rapport 2024", desc: "Le bilan complet de l'année.", url: "/files/rapport.pdf", format: "PDF" },
  { title: "Kit Media", desc: "Logos et photos haute définition.", url: "/files/media.zip", format: "ZIP" },
];
---

<BaseLayout
	title="Ma Veille | Auguste Archiapati"
	description="Mes sujets de veille technologiques"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Ma Veille"
				tagline="Voici les différentes veilles réalisées"
				align="start"
			/>

			<Grid variant="offset">
				{
					docs.map((doc) => (
						<li>
							<DownloadCard
								title={doc.title}
								description={doc.desc}
								url={doc.url}
								tag={doc.format}
							/>
						</li>
					))
				}
			</Grid>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	/* On ajoute un peu d'espace au-dessus de la grille si nécessaire */
	.wrapper {
		margin-bottom: 5rem;
	}
</style>
