---
// src/components/DownloadCard.astro
const { title, description, url, tag } = Astro.props;
---

<div class="download-card">
	<div class="content">
		<span class="tag">{tag}</span>
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
	<a href={url} download class="download-link">
		Télécharger
	</a>
</div>

<style>
	.download-card {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.tag {
		background: var(--accent-light);
		color: var(--accent-text-over);
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		font-size: 0.8rem;
		font-weight: bold;
	}
	h3 { color: var(--gray-0); margin: 0; }
	p { color: var(--gray-300); font-size: 0.9rem; }
	.download-link {
		background: var(--accent-regular);
		color: white;
		text-align: center;
		padding: 0.5rem;
		border-radius: 0.5rem;
		text-decoration: none;
	}
</style>
