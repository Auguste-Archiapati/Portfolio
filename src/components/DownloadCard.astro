// src/components/DownloadCard.astro
interface Props {
  title: string;
  description: string;
  fileUrl: string;
  fileSize?: string; // Optionnel
  format: 'PDF' | 'ZIP' | 'IMG' | 'DOC';
}

const { title, description, fileUrl, fileSize, format } = Astro.props;
---

<div class="card">
  <div class="card-header">
    <span class={`badge ${format.toLowerCase()}`}>{format}</span>
    {fileSize && <span class="size">{fileSize}</span>}
  </div>
  
  <div class="card-body">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>

  <a href={fileUrl} download class="download-button">
    Télécharger
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y1="3"></line></svg>
  </a>
</div>

<style>
  .card {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    background: white;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: bold;
    background: #edf2f7;
  }

  /* Couleurs par format */
  .pdf { background: #fee2e2; color: #991b1b; }
  .zip { background: #fef3c7; color: #92400e; }

  h3 { margin: 0 0 0.5rem 0; font-size: 1.25rem; }
  p { font-size: 0.9rem; color: #4a5568; flex-grow: 1; }

  .download-button {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #3182ce;
    color: white;
    text-decoration: none;
    padding: 10px;
    border-radius: 8px;
    font-weight: 600;
  }
</style>
